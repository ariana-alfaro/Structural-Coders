import type {QuizSnapshot,AuthoredQuestion} from './authoring';
export type Value=number|number[]|string;
export type GameSettings={enabled:boolean;timer:number;speed:boolean;powerups:boolean;leaderboard:boolean};
export type Powerup='doble'|'mitad'|'congelar'|'escudo';
export type Effects={doble?:true;mitad?:number[];congelar?:true;escudo?:true};
export type Run={quizId:string;revision:number;title:string;nick:string;avatar?:string;settings:GameSettings;index:number;score:number;streak:number;best:number;correct:number;progress:number[];inventory:Powerup[];effects:Effects;used:number;done:boolean};
export type RoundResult={correct:boolean;gained:number;streak:number;shieldUsed:boolean;award:Powerup|null;timedOut:boolean;doubled:boolean};
export type PracticeRecord={quizId:string;revision:number;nick:string;avatar?:string;score:number;correct:number;best:number;progress:number[];finished:string};
export const TIMERS:number[];
export const MAX_POWERUPS:number;
export const powerupInfo:Record<Powerup,{label:string;detail:string}>;
export const defaultGame:GameSettings;
export function normalizeGame(g:unknown):GameSettings;
export function poolFor(settings:GameSettings):Powerup[];
export function createRun(quiz:QuizSnapshot,nick:string,rng?:()=>number):Run;
export function usable(run:Run,q:AuthoredQuestion,kind:Powerup):boolean;
export function usePowerup(run:Run,q:AuthoredQuestion,kind:Powerup,rng?:()=>number):Run;
export function answerQuestion(run:Run,q:AuthoredQuestion,value:Value|null,elapsed:number,rng?:()=>number):{run:Run;result:RoundResult|null};
export function advanceRun(run:Run,total:number):Run;
export function rankAt(records:PracticeRecord[],run:Run):{position:number;of:number};
export function leaderboard(records:PracticeRecord[],quizId:string,revision:number):PracticeRecord[];
export function recordOf(run:Run,now?:Date):PracticeRecord;
