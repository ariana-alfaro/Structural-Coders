{
  "name": "structural-coders-quiz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
    "check:realtime": "node scripts/realtime-check.mjs",
    "dev:demo": "vite --host 127.0.0.1 --mode demo",
    "start": "node server/start.mjs",
    "build:local": "tsc -b && vite build --mode demo",
    "build:cloud": "tsc -b && vite build --mode cloud",
    "cloud:seed": "node --env-file=.env.cloud.local scripts/seed-cloud.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
