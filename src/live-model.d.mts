import type {QuizSnapshot,AuthoredQuestion} from './authoring';
export type Value=number|number[]|string;
export type LivePlayer={name:string;score:number;streak:number;correct:number};
export type RoundResult={answered:boolean;correct:boolean;gained:number;streak:number};
export type Phase='lobby'|'question'|'reveal'|'leaderboard'|'podium';
export type Game={pin:string;quiz:QuizSnapshot;limit:number;speed:boolean;phase:Phase;index:number;startedAt:number;players:Record<string,LivePlayer>;order:string[];banned:string[];answers:Record<string,{value:Value;elapsed:number}>;round:Record<string,RoundResult>};
export type PublicQuestion=Omit<AuthoredQuestion,'solution'|'explanation'>;
export type Snapshot={pin:string;phase:Phase;title:string;total:number;index:number;limit:number;speed:boolean;remaining:number;question:PublicQuestion|null;players:{id:string;name:string;score:number;correct:number;streak:number}[];answered:string[];round:Record<string,RoundResult>;reveal:{solution:Value;explanation:string;distribution:number[]|null}|null};
export const MAX_PLAYERS:number;
export function makePin(rng?:()=>number):string;
export function cleanNick(name:unknown):string;
export function publicQuestion(q:AuthoredQuestion):PublicQuestion;
export function validValue(q:{type:string;options:string[]},value:unknown):value is Value;
export function roundPoints(args:{correct:boolean;elapsed:number;limit:number;speed?:boolean;weight?:number;streak?:number}):number;
export function createGame(quiz:QuizSnapshot,options?:{limit?:number;speed?:boolean},rng?:()=>number):Game;
export function addPlayer(game:Game,id:string,name:string):Game;
export function removePlayer(game:Game,id:string):Game;
export function startQuestion(game:Game,now:number):Game;
export function recordLiveAnswer(game:Game,id:string,qIndex:number,value:unknown,now:number):Game;
export function everyoneAnswered(game:Game):boolean;
export function closeQuestion(game:Game):Game;
export function showStandings(game:Game):Game;
export function standings(game:Game):({id:string}&LivePlayer)[];
export function distribution(q:{type:string;options:string[]},answers:Game['answers']):number[]|null;
export function snapshot(game:Game,now:number):Snapshot;
